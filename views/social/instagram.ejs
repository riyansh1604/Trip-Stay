      <div class="ig-post ig-post-9">
        <span class="ig-post-emoji">🏕️</span>
        <div class="ig-post-label">Glamping Night</div>
        <div class="ig-post-overlay">
          <div class="ig-post-stat">♥ 7,024</div>
          <div class="ig-post-stat">💬 389</div>
        </div>
      </div>

    </div>
  </div>

