<% layout("/layouts/boilerplate.ejs") %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const listing = <%- JSON.stringify(listing) %>;
</script>


    <div class="row">
        <div class="col-8 offset-3 mt-3">
        <h2>Details of <%= listing.title %>:</h2>
        </div>
    </div>
    
    <div class="card listing-card col-6 offset-3 show-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image">
        <div class="card-body">
            
            <p class="card-text">
                <p>Owned by <i><%= listing.owner.username %></i> </p>
                <p><%= listing.description %> </p>
                <p>&#8377; <%= listing.price.toLocaleString("en-IN") %> </p>
                <p><%= listing.location %> </p>
                <p><%= listing.country %></p>
            </p>
        </div>
        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>.
            <div class="btns">
                <a href="/listing/<%= listing._id %>/edit"><button class="btn edit-btn mt-3">Edit</button></a>
                <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-dark ms-3 mt-3"> Delete</button>
                </form>
            </div>
        <% } %>
    </div>
    <hr>
    <div class="col-6 offset-3 mb-3 mt-3">
        <% if (currUser) { %>
            <h4>Leave Review's</h4>
            <form action="/listing/<%= listing._id %>/reviews" method="post" >
                <fieldset class="starability-growRotate">
                    <legend>Rating:</legend>
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>

                <div class="md-3 mb-3">
                    <label for="comment" class="form-label">Comment:</label>
                    <textarea type="text" name="review[comment]" class="form-control" required></textarea>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
        <% } %>
        <% if (listing.reviews.length>0) { %>
            <p><b>All Reviews</b></p>
            <div class="row">
                <% for( review of listing.reviews) { %>
                    <div class="card col-md-5 mb-3 ms-3">
                        <div class="card-body">
                            <p class="card-title">@<%= review.author.username %></p>
                            <p class="card-text starability-result" data-rating="<%= review.rating %>"> &#x2B50;</p>
                            <p class="card-text"><%= review.comment %></p>
                        </div>
                        <% if(currUser && review.author._id.equals(currUser._id)) { %>
                            <form action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                                <button class="btn btn-sm btn-dark mb-3 mt-3 ">Delete</button>
                            </form>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% } %>
        
    </div>
    <div class="col-6 offset-3 mb-3 mt-3">
        <h4>Where you'll be:</h4>
        <div id="map" class="mt-3 mb-3"></div>
    </div>
